#! D:/ProgramFile/Nuke17.1v2/Nuke17.1.exe -nx
version 17.1 v2
Gizmo {
 name EditableAlpha
 tile_color 0xe58934ff
 note_font_color 0xffffffff
 addUserKnob {20 EditableAlpha l EditableAlpha}
 addUserKnob {26 ea_title l "" +STARTLINE T "<font size=\"4\" color=\"#FFAA44\"><b>EditableAlpha</b></font> &nbsp;<font color=\"#C8D0D8\">Mask &#8594; Multi-Part Bezier Roto</font>"}
 addUserKnob {26 ea_div_top l ""}
 addUserKnob {3 ea_start_frame l "Start Frame" t "First frame of the sequence to convert." +STARTLINE}
 ea_start_frame 1
 addUserKnob {3 ea_end_frame l "End Frame" t "Last frame of the sequence to convert." -STARTLINE}
 ea_end_frame 100
 addUserKnob {22 ea_sync_range l "Sync Range" t "Sync Start/End frames from the connected input node or Project Settings." -STARTLINE T "import editablealpha_bridge; editablealpha_bridge.on_editablealpha_sync_range(nuke.thisNode())"}
 addUserKnob {4 ea_mask_channel l "Mask Source" t "Select whether to read the mask from the Alpha channel or RGB luminance." +STARTLINE M {"Alpha (RGBA Input)" "Luminance (RGB/BW)"}}
 addUserKnob {3 ea_key_step l "Key Step" t "Keyframe interval (1 = every frame, N = every Nth frame plus reference/boundary frames)." -STARTLINE}
 ea_key_step 1
 addUserKnob {20 ea_geom_group l "Part / Bezier Fitting" n 1}
 addUserKnob {3 ea_max_parts l "Max Parts" t "Maximum number of articulated Bezier parts to decompose the mask into." +STARTLINE}
 ea_max_parts 3
 addUserKnob {3 ea_overlap_px l "Seam Overlap (px)" t "Pixel overlap between adjacent decomposed parts to prevent seam gaps." -STARTLINE}
 ea_overlap_px 12
 addUserKnob {3 ea_min_pts l "Min Points / Part" t "Minimum number of Bezier control points per part." +STARTLINE}
 ea_min_pts 8
 addUserKnob {3 ea_max_pts l "Max Points / Part" t "Maximum number of Bezier control points per part." -STARTLINE}
 ea_max_pts 16
 addUserKnob {7 ea_tension l Tension t "Default Bezier handle tension for fitted curves (lower = tighter, higher = rounder)." R 0.1 0.8}
 ea_tension 0.5
 addUserKnob {7 ea_cusp_angle l "Cusp Angle (deg)" t "Angle threshold in degrees for detecting sharp corners as cusp points." R 25 120}
 ea_cusp_angle 60
 addUserKnob {6 ea_auto_multi_master l "Auto Multi-Master" t "Automatically select multiple master keyframes across the frame range when mask topology changes." +STARTLINE}
 ea_auto_multi_master true
 addUserKnob {1 ea_ref_frames l "Ref Frames (Optional)" t "Optional comma- or space-separated reference frame numbers (auto-populated if blank)." +STARTLINE}
 addUserKnob {20 ea_geom_group_end n -1}
 addUserKnob {26 ea_div_out l ""}
 addUserKnob {26 ea_hdr_out l "" +STARTLINE T "<font color=\"#E8EEF5\"><b>Conversion &amp; Artist Editing</b></font>"}
 addUserKnob {4 ea_output_mode l "Output Mode" t "Choose whether conversion updates the internal Roto, creates a standalone Roto node, or both." M {"Update Internal + Extract Roto" "Update Internal Gizmo Only" "Extract Standalone Roto Only"}}
 addUserKnob {4 ea_view_mode l Preview t "Switch Gizmo output between the converted Bezier Roto and the raw input mask." M {"Converted Roto" "Input Mask"}}
 addUserKnob {22 ea_convert_btn l "<b><font color=\"#FFD166\">&#9654;  Convert Mask to Roto</font></b>" t "Run mask-to-Bezier conversion across the frame range and bake Roto curves." +STARTLINE T "import editablealpha_bridge; editablealpha_bridge.on_editablealpha_convert(nuke.thisNode())"}
 addUserKnob {22 ea_extract_btn l "Extract Editable Roto" t "Create or update a standalone editable Roto node from the last conversion." +STARTLINE T "import editablealpha_bridge; editablealpha_bridge.on_editablealpha_extract_roto(nuke.thisNode())"}
 addUserKnob {22 ea_retrack_btn l "Re-Track (Keep Edits)" t "Preserve manual Bezier edits at the current frame and re-track adjacent frames." -STARTLINE T "import editablealpha_bridge; editablealpha_bridge.on_editablealpha_retrack_manual(nuke.thisNode())"}
 addUserKnob {1 ea_status l Status t "Current conversion status and J&F quality metrics."}
 ea_status "Ready. Connect a mask input and click Convert Mask to Roto."
 addUserKnob {26 ea_div_env l ""}
 addUserKnob {20 ea_env_group l "Worker Environment" n 1}
 ea_env_group 0
 addUserKnob {2 ea_python_path l "Worker Python" t "Optional path to external Python executable with OpenCV and NumPy installed."}
 addUserKnob {22 ea_check_env l "Check Env" t "Verify external Worker Python (cv2 + numpy), Gizmo, and worker script availability." -STARTLINE T "import editablealpha_bridge; editablealpha_bridge.check_environment_status(nuke.thisNode())"}
 addUserKnob {20 ea_env_group_end n -1}
 addUserKnob {1 ea_last_project_json l "" +INVISIBLE}
}
 Input {
  inputs 0
  name mask
  xpos 0
  ypos -180
 }
 set N_ea_mask_in [stack 0]
 Roto {
  inputs 1
  output alpha
  replace true
  name EditableAlpha_Roto
  xpos -80
  ypos -60
 }
 push $N_ea_mask_in
 Switch {
  inputs 2
  which {{parent.ea_view_mode}}
  name ViewSwitch
  xpos 0
  ypos 60
 }
 Output {
  name Output1
  xpos 0
  ypos 160
 }
end_group
